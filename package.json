{
  "name": "bcuk-bot",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "watch": "rolldown -c rolldown.config.ts -w",
    "placeholders": "node scripts/gen-placeholders.js",
    "pack": "streamdeck pack com.expiredminotaur.bcuk.sdPlugin --force",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.4"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.4",
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.14.0",
    "eslint-plugin-html": "^8.2.1",
    "eslint-plugin-jsdoc": "^65.4.5",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "rolldown": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "zod": "^4.6.6",
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
