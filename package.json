{
  "name": "bcuk-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "watch": "rolldown -c rolldown.config.ts -w",
    "placeholders": "node scripts/gen-placeholders.js",
    "pack": "streamdeck pack com.expiredminotaur.bcuk.sdPlugin --force",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.2"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.2",
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "^20.19.43",
    "rolldown": "^1.2.14",
    "sharp": "^0.35.5",
    "typescript": "^5.2.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
