{
  "name": "bcuk-bot",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "watch": "rolldown -c rolldown.config.ts -w",
    "placeholders": "node scripts/gen-placeholders.js",
    "pack": "streamdeck pack com.expiredminotaur.bcuk.sdPlugin --force",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.3"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.2",
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.13.0",
    "eslint-plugin-html": "^8.2.1",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "rolldown": "^1.2.14",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "zod": "^4.6.6"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
