{
	"Name": "BCUK Bot",
	"Version": "1.6.0.0",
	"Author": "BCUK",
	"Description": "Control BCUK Bot directly from your Stream Deck.",
	"Icon": "imgs/plugin/marketplace",
	"Category": "BCUK Bot",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		},
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		}
	],
	"Nodejs": {
		"Version": "24"
	},
	"UUID": "com.expiredminotaur.bcuk",
	"Actions": [
		{
			"Name": "Play SFX",
			"UUID": "com.expiredminotaur.bcuk.play",
			"Icon": "imgs/actions/play-sfx/icon",
			"Tooltip": "Trigger a BCUK Bot sound effect.",
			"PropertyInspectorPath": "ui/play-sfx.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/play-sfx/key-default",
					"Name": "Default"
				}
			]
		},
		{
			"Name": "Join Voice",
			"UUID": "com.expiredminotaur.bcuk.join",
			"Icon": "imgs/actions/join-voice/icon",
			"Tooltip": "Join a Discord voice channel.",
			"PropertyInspectorPath": "ui/join-voice.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/join-voice/key-default",
					"Name": "Default"
				}
			]
		},
		{
			"Name": "Leave Voice",
			"UUID": "com.expiredminotaur.bcuk.leave",
			"Icon": "imgs/actions/leave-voice/icon",
			"Tooltip": "Leave the current Discord voice channel.",
			"PropertyInspectorPath": "ui/leave-voice.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/leave-voice/key-default",
					"Name": "Default"
				}
			]
		},
		{
			"Name": "Trigger Command",
			"UUID": "com.expiredminotaur.bcuk.command",
			"Icon": "imgs/actions/trigger-command/icon",
			"Tooltip": "Fire one of your advanced commands for free.",
			"PropertyInspectorPath": "ui/advanced-command.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/trigger-command/key-default",
					"Name": "Default"
				}
			]
		},
		{
			"Name": "Toggle Command",
			"UUID": "com.expiredminotaur.bcuk.command-toggle",
			"Icon": "imgs/actions/toggle-command/icon",
			"Tooltip": "Enable or disable one of your advanced commands.",
			"PropertyInspectorPath": "ui/advanced-command.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/toggle-command/key-on",
					"Name": "Enabled"
				},
				{
					"Image": "imgs/actions/toggle-command/key-off",
					"Name": "Disabled"
				}
			]
		},
		{
			"Name": "Start Raffle",
			"UUID": "com.expiredminotaur.bcuk.raffle",
			"Icon": "imgs/actions/start-raffle/icon",
			"Tooltip": "Give away loyalty points: viewers type !join in your chat for 60 seconds.",
			"PropertyInspectorPath": "ui/start-raffle.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/start-raffle/key-default",
					"Name": "Default"
				}
			]
		}
	]
}